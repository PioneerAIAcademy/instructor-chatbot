# Instructor Assistant frontend (Next.js static export).
# NEXT_PUBLIC_* values are compiled into the JavaScript at BUILD time and are
# visible to anyone who opens the site. Never put a secret in one.

# The backend's origin (the app calls <origin>/api/v1/chat and friends).
NEXT_PUBLIC_CHAT_API=http://localhost:8000

# The key the backend expects in X-API-Key (one of its API_KEYS). It ships in
# the bundle: a rate-limit speed bump, not an access control (CLAUDE.md §2).
# Leave empty locally when the backend runs with ENVIRONMENT=dev and no keys.
NEXT_PUBLIC_API_KEY=

# The site's own public URL (https://...), for social previews and canonical links.
# NEXT_PUBLIC_SITE_URL=

# The instructor help page linked from Settings. The Help item is hidden until set.
# NEXT_PUBLIC_HELP_URL=

# The Instructor Assistant's Sentry project (CLAUDE.md §13 Q5). Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Build-time only (CI): source map upload to Sentry. Never NEXT_PUBLIC_.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Local tunnel testing only: proxy /api/* to this backend (next dev).
# DEV_PROXY_BACKEND=
