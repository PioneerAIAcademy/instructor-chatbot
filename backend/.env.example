# BYU-Pathway Instructor Assistant — backend environment.
# Names only. Copy to .env (gitignored) and fill values locally. Never commit
# values. See CLAUDE.md §11 for what each variable does.

# --- LLM and embeddings (must match the index: text-embedding-3-large, 3072) ---
OPENAI_API_KEY=
MODEL_PROVIDER=openai
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
# LLM_MAX_TOKENS=
# OPENAI_EMBED_TIMEOUT_SECONDS=20
# OPENAI_EMBED_MAX_RETRIES=3

# --- Pinecone (instructor account; read-only use) ---
# Never reuse the missionary bot's key: the instructor index lives in a separate account.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=instructor-assistant
PINECONE_ENVIRONMENT=us-east-1
# Optional: skips the control-plane lookup. Must start with "<index name>-" (Phase 1 guard).
# PINECONE_INDEX_HOST=
# PINECONE_REQUEST_TIMEOUT_SECONDS=12
# PINECONE_POOL_MAXSIZE=20
# PINECONE_STORE_CACHE_ENABLED=true
# PINECONE_INCLUDE_VALUES_ENABLED=false

# --- Audience guards ---
# Boot allow-list (Phase 1). Add a staging index name here, never "pathway".
# ALLOWED_INDEX_NAMES=instructor-assistant
# The `source` filter. Dropping the linked source is allowed; adding values is a code-review decision.
# RETRIEVAL_SOURCES=instructor-assistant,instructor-assistant-linked
# Hosts whose links get "(sign-in required)" (Phase 3, suffix match).
# LOGIN_LINK_HOSTS=sharepoint.com,companion.byupathway.edu,pathwayadmin.byui.edu,portal.byupathway.edu

# --- Security screen ---
# The ML prompt-injection detector (pytector, ~714 MB model downloaded from
# Hugging Face on first start, ~0.5 GB RAM per server process). On by default.
# PROMPT_INJECTION_ML_ENABLED=true

# --- Reranker ---
VOYAGE_API_KEY=

# --- Langfuse (instructor project) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# LANGFUSE_LLAMAINDEX_ENABLED=true
# APP_VERSION=

# --- Sentry (instructor project) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Keep PII off.
# SENTRY_SEND_PII=false

# --- Server ---
ENVIRONMENT=dev
# Required outside dev. Not a secret from users: it ships in the frontend bundle.
API_KEYS=
ALLOWED_ORIGINS=
CORS_ALLOW_ALL=false
# APP_HOST=0.0.0.0
# APP_PORT=8000
# TYPEWRITER_CHUNK_DELAY=0.004

# Starter questions served by /api/v1/chat/config, one per line (a literal \n also
# separates them). "Title | question" shows as a welcome card with that title, and
# the question is what gets asked. Unset: the 4 built-in instructor cards below
# (app/api/routers/chat_config.py). Set but empty: no cards. The Spanish and
# Portuguese interfaces read CONVERSATION_STARTERS_ES / CONVERSATION_STARTERS_PT
# the same way (built-in Spanish / Portuguese cards when unset).
# CONVERSATION_STARTERS="Pay dates | When do I get paid this block?\nExtend a due date | How do I give one student more time on an assignment in Canvas?\nAn unresolved student issue | A student has submitted several tickets with no resolution. What can I do?\nWrite a welcome message | Write a welcome message for my students."

# --- Feedback screenshots (optional) ---
# CLOUDINARY_URL=
# or CLOUDINARY_CLOUD_NAME= / CLOUDINARY_API_KEY= / CLOUDINARY_API_SECRET=

# --- Opt-in billable tests ---
# RUN_LIVE_TESTS=1
# RUN_LLM_JUDGE=1
